# civil3d-mcp  –  environment variables
#
# 2026-08-18 정정: 예전 주석은 "The server reads these at startup via os.getenv()"
# 였으나 **서버는 이 파일을 읽지 않는다.** 저장소에서 load_dotenv 를 호출하는 곳은
# experiments/harness_d.py:49,53 뿐이다. client.py:68 의 os.getenv 는 *프로세스
# 환경변수*만 본다 — .env 에 적어도 서버에는 전달되지 않는다.
#
#   CIVIL3D_BIN_PATH  -> 진짜 환경변수로 주거나(아래 A), Claude Desktop 설정의
#                        "env" 블록에 넣어야(아래 B) 서버에 전달된다.
#   ANTHROPIC_API_KEY -> 이 파일이 실제로 쓰이는 유일한 항목(harness_d.py 전용).
#
#   A)  $env:CIVIL3D_BIN_PATH = "C:\Program Files\Autodesk\AutoCAD 2026\C3D"
#   B)  claude_desktop_config.json 의 mcpServers.civil3d-mcp.env 에 같은 키를 추가

# Optional: explicit path to the Civil 3D binary folder
# (the folder that contains AeccDbMgd.dll; note that acdbmgd.dll normally sits
#  one level up, and AeccLandMgd.dll only exists on Civil 3D 2023/2024)
# Default: auto-detected from standard Autodesk install paths (2023-2026).
# CIVIL3D_BIN_PATH=C:\Program Files\Autodesk\AutoCAD 2026\C3D

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Only needed by experiments/harness_d.py (the API route for comparison group D).
# The manual Claude Desktop route does not use it.
# 2026-08-18: this line was missing even though harness_d.py reads the variable.
# ANTHROPIC_API_KEY=sk-ant-...
